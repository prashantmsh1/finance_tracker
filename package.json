{
    "name": "expense-tracker",
    "private": true,
    "scripts": {
        "dev": "turbo dev",
        "build": "turbo build",
        "lint": "turbo lint",
        "db:generate": "pnpm --filter @expense-tracker/db exec drizzle-kit generate",
        "db:migrate": "pnpm --filter @expense-tracker/db exec drizzle-kit migrate",
        "db:push": "pnpm --filter @expense-tracker/db exec drizzle-kit push",
        "db:dev": "pnpm --filter @expense-tracker/db exec drizzle-kit studio"
    },
    "devDependencies": {
        "turbo": "^2"
    },
    "packageManager": "pnpm@9.15.4"
}
